{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "unresolved", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["ship", "fix"] },
    "summary": { "type": "string" },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "why"],
        "properties": { "id": { "type": "string" }, "why": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "where", "problem", "evidence", "fix"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "where": { "type": "string" },
          "problem": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
